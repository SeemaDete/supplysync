# ─────────────────────────────────────────────────────────────
# SupplySync environment variables
# Copy to .env (local) and add the same keys in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Supabase Postgres
# Pooled connection (port 6543, transaction pooler) - used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) - used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js - generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Needed on Vercel so Auth.js trusts the forwarded host
AUTH_TRUST_HOST=true
# Public base URL of the app (used in email links)
APP_URL="https://supplysync.vercel.app"
APP_TIMEZONE="Asia/Kolkata"
# Show one-click demo accounts on the login page (set false in production)
SHOW_DEMO_LOGINS=true

# Microsoft Entra ID (optional - the button only appears when these are set)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Email (SMTP). Works with Office 365 (smtp.office365.com:587), Gmail, SendGrid, Resend SMTP, etc.
# If not set, "Send" fails cleanly and the email is recorded as FAILED (never as SENT).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SupplySync <noreply@company.com>"

# Vercel Cron protection - Vercel sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="replace-with-another-random-string"

# File storage (optional). If unset, attachments are stored in Postgres (fine for demo, max ~4 MB/file)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# Power BI Embedded (optional) - a "Publish to web"/secure embed URL shown on the Reports page
POWERBI_EMBED_URL=""
